# JARVIS runtime configuration — copy to .env and fill in. Never commit .env.
# The full variable reference lives in JARVIS.md.

# Required
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Spotify (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PREFERRED_DEVICE=JARVIS

# Home Assistant (optional)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_MONITOR_ENABLED=true
HOME_MONITOR_TRANSPORT=websocket
HOME_MONITOR_RECONNECT_S=5
HOME_MONITOR_DOMAINS=light,switch,fan,media_player,binary_sensor,person,device_tracker,lock,cover,climate

# Radarr / Sonarr (optional)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=
RADARR_ROOT_FOLDER=
SONARR_ROOT_FOLDER=
RADARR_DEFAULT_QUALITY=1080p
SONARR_DEFAULT_QUALITY=1080p
SONARR_MONITOR_STRATEGY=future
RADARR_QUALITY_MAP=1080p => HD-1080p; 4k => Ultra-HD
SONARR_QUALITY_MAP=1080p => HD-1080p; 4k => Ultra-HD

# qBittorrent WebUI (optional)
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_MONITOR_ENABLED=true
QBITTORRENT_MONITOR_INTERVAL_S=30
QBITTORRENT_ANNOUNCE_COMPLETIONS=true

# Companion dashboard (optional)
# Plex has no server-side integration; this base URL is used only for the
# /api/links and /api/status/services dashboard endpoints.
PLEX_URL=
# Comma-separated Home Assistant entity_ids surfaced by /api/home/entities.
HOME_DASHBOARD_ENTITIES=
# The single mounted filesystem containing video files. When blank, Core falls
# back to RADARR_ROOT_FOLDER and then SONARR_ROOT_FOLDER.
MEDIA_STORAGE_PATH=
MEDIA_STORAGE_LABEL=Media storage

# Persona / runtime tunables
HUMOR_PERCENT=30
ADDRESS=sir
ELEVENLABS_SPEED=1.155
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
DEFAULT_LOCATION=Herriman, Utah
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
WEB_SEARCH_ENABLED=true
PRICE_WATCH_MONITOR_ENABLED=true
PRICE_WATCH_INTERVAL_S=21600
PRICE_WATCH_DROP_PERCENT=5
PRICE_WATCH_TIMEOUT_S=15

# Voice tuning
WAKE_THRESHOLD=0.5
PREROLL_SECONDS=4.0
FOLLOWUP_TIMEOUT_S=10.0
FOLLOWUP_TASK_S=2.5
INTERRUPT_RMS_THRESHOLD=1500
WHISPER_MODEL=small.en
# Default is one deterministic decode (fast, stable latency on CPU); true
# restores faster-whisper's re-decode-on-low-confidence temperature schedule.
WHISPER_TEMPERATURE_FALLBACK=false

# Feature flags / tuning
BRIEFING_ON_LAUNCH=false
STREAMING_TTS=false
MEMORY_MAX_FACTS=60
MEMORY_RELEVANT_FACTS=12
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INDEX_FOLDERS=Jarvis Memory
OBSIDIAN_MAX_RESULTS=4
OBSIDIAN_MAX_CHARS=4000
OBSIDIAN_MAX_FILE_BYTES=1000000
OBSIDIAN_JOURNAL_FOLDER=Jarvis Memory/Journal
OBSIDIAN_NOTES_FOLDER=Jarvis Memory/Notes
MEMORY_AUTO_EXTRACT=true
MEMORY_EXTRACT_MODEL=claude-haiku-4-5-20251001
MEMORY_AUTO_CONFIDENCE=0.75
MEMORY_EXTRACT_MIN_CHARS=12
HABITS_MIN_TURNS=10
VISION_MODEL=claude-sonnet-4-6
VISION_ALL_MONITORS=true
WEB_SEARCH_MAX_USES=5
BOOT_SEQUENCE=true

# Optional local conversational fallback (OpenAI-compatible API)
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=
LOCAL_MODEL_TIMEOUT_S=8
LOCAL_MODEL_FAILURE_COOLDOWN_S=30
LOCAL_MODEL_SEMANTIC_ROUTING=true
LOCAL_MODEL_HOME_CONTROL_CONFIDENCE=0.85
LOCAL_MODEL_SUMMARIES=false
LOCAL_MODEL_API_KEY=

# iOS companion server
JARVIS_API_TOKEN=
JARVIS_SERVER_HOST=0.0.0.0
JARVIS_SERVER_PORT=8000

# Google Calendar (optional, read-only)
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_CALENDAR_ID=primary
CALENDAR_MONITOR_ENABLED=true
CALENDAR_MONITOR_INTERVAL_S=120
CALENDAR_ALERT_LEAD_MIN=10

# NAS arr health/recovery (opt-in; no Docker socket or root SSH)
ARR_STACK_MONITOR_ENABLED=false
ARR_STACK_MONITOR_INTERVAL_S=60
# One reminder per window while a condition stays unresolved (critical or
# advisory) -- not a repeat every cycle, and not silence forever.
ARR_STACK_ESCALATION_INTERVAL_S=21600
# After a critical condition recovers, suppress the first notice for any
# brand-new condition for this long -- often still settling (recreated
# containers, restarted apps). 0 disables. Does not affect already-active
# conditions or their escalation.
ARR_STACK_POST_RECOVERY_GRACE_S=300
# Hysteresis: polls a condition must persist before alerting / stay clear
# before "Recovered". Zero-DHT threshold sits above a normal ~8 min recovery.
ARR_STACK_ALERT_CONFIRM_CHECKS=3
ARR_STACK_RECOVERY_CONFIRM_CHECKS=2
ARR_STACK_DHT_ZERO_CHECKS=10
# Hold new alerts this long after a NAS recovery finishes (needs status key).
ARR_STACK_MAINTENANCE_SETTLE_S=300
# Existing HA iPhone notification service; blank keeps runtime inbox/voice only.
ARR_STACK_NOTIFY_SERVICE=notify.mobile_app_nicks_iphone_17_pro
# Phone alerts route through brain/notifications.py: JARVIS companion push
# first, this HA service as fallback. JARVIS_NOTIFY_HA_SERVICE overrides the
# older ARR_STACK_NOTIFY_SERVICE name.
# JARVIS_NOTIFY_HA_SERVICE=notify.mobile_app_nicks_iphone_17_pro
# Companion push (APNs) -- STUBBED. Needs Apple Developer Program + APNs key.
# Leave off; HA stays primary until the sender is implemented.
APNS_ENABLED=false
# APNS_KEY_PATH=/home/nick/jarvis/memory/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
PROWLARR_URL=http://10.0.0.147:9696
# Required for Prowlarr's authenticated /api/v1/health (proxy/indexer
# failures, including a down Byparr, which Prowlarr reaches internally and
# this is the only supported way to detect from outside the stack); without
# it, monitoring falls back to an unauthenticated /ping (reachability only).
PROWLARR_API_KEY=
# No longer checked directly: Byparr's :8191 is not published on the host by
# design, so it is unreachable from outside the stack. See PROWLARR_API_KEY.
BYPARR_URL=http://10.0.0.147:8191
ARR_STACK_RESTART_ENABLED=false
# How long the post-restart follow-up watches before reporting per-service status.
ARR_RECOVERY_FOLLOW_S=720
NAS_SSH_HOST=100.97.179.53
# Dedicated non-admin NAS account; UGOS gives admin/root-group logins an
# unrestricted shell regardless of authorized_keys restrictions.
NAS_SSH_USER=Jarvis
NAS_RECOVERY_SSH_KEY=/home/nick/.ssh/jarvis_nas_recovery
NAS_STATUS_SSH_KEY=/home/nick/.ssh/jarvis_nas_status
NAS_SSH_KNOWN_HOSTS=/home/nick/.ssh/jarvis_nas_known_hosts
# Secret Healthchecks ping URL (create check/notification integration in account).
# Keep this interval well under the check's period so a single missed ping
# never trips the alert; 60s against a 5-minute period/grace leaves ~10x margin.
JARVIS_HEALTHCHECKS_URL=
JARVIS_HEALTHCHECKS_INTERVAL_S=60
